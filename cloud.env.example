# Copy to a secret-managed environment; never commit real credentials.
QUANTPULSE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/railway?sslmode=require
QUANTPULSE_ALLOWED_ORIGINS=https://dashboard.example.com
QUANTPULSE_ADMIN_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
QUANTPULSE_RATE_LIMIT_PER_MINUTE=120
QUANTPULSE_ADMIN_RATE_LIMIT_PER_MINUTE=30
QUANTPULSE_DATABASE_POOL_SIZE=5
QUANTPULSE_DATABASE_MAX_OVERFLOW=5
QUANTPULSE_DATABASE_POOL_TIMEOUT_SECONDS=30
QUANTPULSE_DATABASE_POOL_RECYCLE_SECONDS=1800
QUANTPULSE_PIPELINE_RETENTION_ENABLED=true
QUANTPULSE_PIPELINE_RETENTION_DAYS=30
QUANTPULSE_PIPELINE_RETENTION_BATCH_SIZE=2500
# Include pipeline_retention in QUANTPULSE_SCHEDULER_JOBS on the worker service.
# It deletes only completed operational ledger rows older than 30 days.
FRED_API_KEY=REPLACE_WITH_FRED_API_KEY
FRED_TIMEOUT_SECONDS=10
FRED_CACHE_SECONDS=1800
VITE_BACKEND_URL=https://api.example.com
# Set this on the frontend service to a Railway reference variable such as:
# http://${{QuantPulseAI.RAILWAY_PRIVATE_DOMAIN}}:${{QuantPulseAI.PORT}}
QUANTPULSE_API_UPSTREAM=https://api.example.com

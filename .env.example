QUANTPULSE_ENV=development
SETUPTOOLS_USE_DISTUTILS=stdlib
QUANTPULSE_START_SCHEDULER=false
QUANTPULSE_SCHEDULER_JOBS=market,feature,regime,orderflow,smc,watchlist_persist,risk,paper_trade_execute,paper_trade_monitor

# Option A: provide the complete SQLAlchemy URL.
# QUANTPULSE_DATABASE_URL=mssql+pyodbc://@(localdb)\MSSQLLocalDB/QuantPulseAI?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# Option B: let the app build the SQL Server URL from parts.
QUANTPULSE_SQLSERVER=(localdb)\MSSQLLocalDB
QUANTPULSE_DATABASE=QuantPulseAI
QUANTPULSE_SQL_DRIVER=ODBC Driver 17 for SQL Server
QUANTPULSE_SQL_TRUSTED_CONNECTION=yes

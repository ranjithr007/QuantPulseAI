QUANTPULSE_ENV=development
SETUPTOOLS_USE_DISTUTILS=stdlib
QUANTPULSE_PROCESS_ROLE=all
QUANTPULSE_HOST=127.0.0.1
QUANTPULSE_PORT=8000
QUANTPULSE_START_SCHEDULER=false
QUANTPULSE_START_LIVE_MARKET=true
QUANTPULSE_SCHEDULER_JOBS=deterministic_pipeline,derivative,candle_completeness,liquidations,whales,whale_ai,heatmap,orderbook
QUANTPULSE_ALLOW_SQLITE_FALLBACK=true
QUANTPULSE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
QUANTPULSE_REQUIRE_ADMIN_AUTH=false
QUANTPULSE_RATE_LIMIT_ENABLED=false
QUANTPULSE_RATE_LIMIT_PER_MINUTE=120
QUANTPULSE_ADMIN_RATE_LIMIT_PER_MINUTE=30
QUANTPULSE_TRUST_PROXY_HEADERS=false
QUANTPULSE_DATABASE_POOL_SIZE=5
QUANTPULSE_DATABASE_MAX_OVERFLOW=5
QUANTPULSE_DATABASE_POOL_TIMEOUT_SECONDS=30
QUANTPULSE_DATABASE_POOL_RECYCLE_SECONDS=1800
QUANTPULSE_PIPELINE_RETENTION_ENABLED=false
QUANTPULSE_PIPELINE_RETENTION_DAYS=30
QUANTPULSE_PIPELINE_RETENTION_BATCH_SIZE=2500
# After reviewing scripts/check_pipeline_retention.py output, append
# pipeline_retention to QUANTPULSE_SCHEDULER_JOBS and set enabled=true.

# Verified FRED macro context. Keep the real key in Railway/local secrets.
FRED_API_KEY=
FRED_TIMEOUT_SECONDS=10
FRED_CACHE_SECONDS=1800

# Option A: provide the complete SQLAlchemy URL.
# QUANTPULSE_DATABASE_URL=mssql+pyodbc://@(localdb)\MSSQLLocalDB/QuantPulseAI?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# Option B: let the app build the SQL Server URL from parts.
QUANTPULSE_SQLSERVER=(localdb)\MSSQLLocalDB
QUANTPULSE_DATABASE=QuantPulseAI
QUANTPULSE_SQL_DRIVER=ODBC Driver 17 for SQL Server
QUANTPULSE_SQL_TRUSTED_CONNECTION=yes

# Production safety baseline:
# QUANTPULSE_ENV=production
# QUANTPULSE_PROCESS_ROLE=api
# QUANTPULSE_HOST=0.0.0.0
# PORT=8000
# QUANTPULSE_START_SCHEDULER=false
# QUANTPULSE_ALLOW_SQLITE_FALLBACK=false
# QUANTPULSE_ALLOWED_ORIGINS=https://dashboard.example.com
# QUANTPULSE_REQUIRE_ADMIN_AUTH=true
# QUANTPULSE_ADMIN_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# QUANTPULSE_RATE_LIMIT_ENABLED=true
# QUANTPULSE_RATE_LIMIT_PER_MINUTE=120
# QUANTPULSE_ADMIN_RATE_LIMIT_PER_MINUTE=30
# QUANTPULSE_TRUST_PROXY_HEADERS=true
# QUANTPULSE_DATABASE_URL=mssql+pyodbc://USER:PASSWORD@SERVER/DATABASE?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
